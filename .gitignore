# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# Node
node_modules/
local-lock.json

# Secrets — never commit API keys
.env
.env.*
!.env.example

# Local caches / scratch
.cache/
*.sqlite
*.db
dumps/

# OS
.DS_Store
Thumbs.db

# Editors
.vscode/
.idea/

# Agent scratch — throwaway git worktrees, not source. Also keeps `ruff check .`
# from linting whatever half-finished branch happens to be checked out there.
.claude/
